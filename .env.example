# ─────────────────────────────────────────────────────────────
# AI provider (OpenAI-compatible Chat Completions API)
# Leave AI_API_KEY empty to run in DEMO/MOCK mode (no network calls).
# Works with OpenAI, Groq, OpenRouter, Together, local Ollama, etc.
# ─────────────────────────────────────────────────────────────
AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────────────────────
# Whop paid-access gating (fully wired via @whop/api — no code changes needed)
# Set WHOP_ACCESS_ENABLED=true to require an active Whop membership.
# When false/unset, the app runs "open" (great for dev + demos).
# ─────────────────────────────────────────────────────────────
WHOP_ACCESS_ENABLED=false
# WHOP_API_KEY=
# WHOP_APP_ID=app_xxxxx
# NEXT_PUBLIC_WHOP_APP_ID=app_xxxxx
# WHOP_EXPERIENCE_ID=exp_xxxxx   # the experience that embeds your app
